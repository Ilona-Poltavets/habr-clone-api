ION_PULSE_ENVIRONMENT=local
ION_PULSE_DEBUG=true
ION_PULSE_DATABASE_URL=postgresql+asyncpg://ion_pulse:ion_pulse@localhost:5432/ion_pulse
ION_PULSE_CORS_ORIGINS=["http://localhost:5173"]
ION_PULSE_SESSION_SECRET=replace-this-with-a-long-random-secret
ION_PULSE_SESSION_COOKIE_SECURE=false
ION_PULSE_AI_REVIEW_PROVIDER=none
# Set provider to openai_compatible and provide a key to enable real review calls.
# ION_PULSE_AI_REVIEW_API_KEY=
# ION_PULSE_AI_REVIEW_MODEL=gpt-4.1-mini
ION_PULSE_TRANSLATION_PROVIDER=none
# ION_PULSE_TRANSLATION_API_KEY=
# ION_PULSE_TRANSLATION_MODEL=gpt-4.1-mini
# Set both values before running `uv run python -m ion_pulse.seeds`.
# ION_PULSE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# ION_PULSE_BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
# ION_PULSE_BOOTSTRAP_ADMIN_DISPLAY_NAME=admin
# Set to true only for a deliberate one-time reset of an existing bootstrap account.
# ION_PULSE_BOOTSTRAP_ADMIN_RESET_PASSWORD=false
