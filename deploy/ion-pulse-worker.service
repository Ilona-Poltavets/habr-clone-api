[Unit]
Description=Ion Pulse background worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/ion-pulse-api
EnvironmentFile=/etc/ion-pulse/api.env
ExecStart=/usr/local/bin/uv run python -m ion_pulse.workers.translation
Restart=always
RestartSec=5
User=ion-pulse
Group=ion-pulse

[Install]
WantedBy=multi-user.target
